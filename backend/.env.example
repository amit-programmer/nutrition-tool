# .env.example
# Rename this file to .env and fill in your actual values.

# The port your Express backend will run on
PORT=5000

# The URL of your frontend, required for CORS (e.g. http://localhost:5173 for Vite)
ALLOWED_ORIGIN=http://localhost:5173

# Your Groq API key from https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEY_2=gsk_your_second_groq_api_key_here

# Your Google Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# The Llama model to use for analysis (e.g., llama-3.1-70b-versatile or llama3-70b-8192)
GROQ_CHAT_MODEL=openai/gpt-oss-120b
